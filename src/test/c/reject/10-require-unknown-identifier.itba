// PENDIENTE: hoy el compilador lo acepta (status 0) porque todavía no está
// implementado el análisis semántico del backend. Es sintácticamente válido.

pipeline aplicar_tasa(tasa) require descuento >= 0 {
    MUTATE final = precio * (1 + tasa)
}

LOAD "in.csv"
APPLY aplicar_tasa(0.21)
SAVE "out.csv"
