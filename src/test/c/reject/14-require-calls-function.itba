// PENDIENTE: hoy el compilador lo acepta (status 0) porque el análisis
// semántico todavía no prohíbe llamadas a funciones dentro de un require.

function recargo(x) { return x * 0.05; }

pipeline aplicar_tasa(tasa) require recargo(tasa) < 1 {
    MUTATE final = @precio_base * (1 + tasa)
}

LOAD "in.csv"
APPLY aplicar_tasa(0.21)
SAVE "out.csv"
